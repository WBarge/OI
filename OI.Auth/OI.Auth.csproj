<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>57a3f113-8216-4062-941f-ad1ac0d85166</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <!-- Brings in Microsoft.IdentityModel.JsonWebTokens, which AccessTokenFactory uses to sign tokens,
         and the JWT bearer handler OI.Auth uses to check its own tokens on the administration endpoints. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <!-- PasswordHasher used by IdentityPasswordService -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="11.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OI.Business\OI.Business.csproj" />
    <ProjectReference Include="..\OI.Common\OI.Common.csproj" />
    <ProjectReference Include="..\OI.Data\OI.Data.csproj" />
    <ProjectReference Include="..\OI.Glue\OI.Glue.csproj" />
    <ProjectReference Include="..\OI.Integration\OI.Integration.csproj" />
  </ItemGroup>

</Project>
