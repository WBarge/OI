<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>57a3f113-8216-4062-941f-ad1ac0d85166</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <!-- Brings in Microsoft.IdentityModel.JsonWebTokens, which AccessTokenFactory uses to sign tokens.
         (OI.Auth only issues tokens; it does not validate them, so no authentication middleware here.) -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <!-- PasswordHasher used by IdentityPasswordService -->
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OI.Business\OI.Business.csproj" />
    <ProjectReference Include="..\OI.Common\OI.Common.csproj" />
    <ProjectReference Include="..\OI.Data\OI.Data.csproj" />
    <ProjectReference Include="..\OI.Glue\OI.Glue.csproj" />
  </ItemGroup>

</Project>
