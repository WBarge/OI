{
  // For more information, visit: https://go.microsoft.com/fwlink/?LinkId=733558
  //
  // These are plain shell tasks that run "npm run ..." themselves. The "npm" task type was dropped because VS Code
  // guesses the package manager for it, and with UI\package.json declaring "workspaces" it guessed yarn.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "serve",
      "type": "shell",
      "command": "npm run start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "run tests",
      "type": "shell",
      "command": "npm run test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Changes detected"
          },
          "endsPattern": {
            "regexp": "bundle generation (complete|failed)"
          }
        }
      }
    },
    {
      "label": "dev proxy",
      "type": "shell",
      "command": "npm run dev-proxy --prefix ..",
      "isBackground": true,
      "problemMatcher": {
        "owner": "dev-proxy",
        "pattern": {
          "regexp": "^DEV-PROXY-ERROR: (.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": {
            "regexp": "Starting dev proxy"
          },
          "endsPattern": {
            "regexp": "Dev proxy listening"
          }
        }
      }
    },
    {
      "label": "start with proxy",
      "dependsOn": [
        "serve",
        "dev proxy"
      ],
      "dependsOrder": "parallel"
    }
  ]
}
