{
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [

    {
      // Browse through the dev proxy (http://localhost:4300), not the app's own port: the OI UI and this UI
      // must share one address to share one sign-in. "start with proxy" starts ng serve and the proxy.
      "name": "ng serve",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "start with proxy",
      "url": "http://localhost:4300/products/",
      "runtimeExecutable": "C:\\Users\\Admin\\AppData\\Local\\Google\\Chrome SxS\\Application\\chrome.exe"
    },
    {
      // the Vitest UI (the same as typing testui in the terminal)
      "name": "ng test",
      "type": "chrome",
      "request": "launch",
      "preLaunchTask": "npm: testui",
      "url": "http://localhost:51204/__vitest__/#/",
      "runtimeExecutable": "C:\\Users\\Admin\\AppData\\Local\\Google\\Chrome SxS\\Application\\chrome.exe"
    }
  ]
}
