  "paths": {
    "/api/Orders": {
      "post": {
        "tags": [
          "Orders"
        ],
        "summary": "Creates a new order.",
        "requestBody": {
          "description": "The cancellation token.",
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/CreateOrder"
                  }
                ]
              }
            },
            "text/json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/CreateOrder"
                  }
                ]
              }
            },
            "application/*+json": {
              "schema": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/components/schemas/CreateOrder"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/IOrder"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IOrder"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/IOrder"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/Ping": {
      "get": {
        "tags": [
          "Ping"
        ],
        "summary": "Will always return a 200\r\nThis endpoint it to be used to validate the service is up and running",
        "responses": {
          "200": {
            "description": "IActionResult."
          }
        }
      }
    },
    "/api/States": {
      "get": {
        "tags": [
          "States"
        ],
        "summary": "Returns all states.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IState"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IState"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IState"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
