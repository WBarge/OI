{
  "openapi": "3.1.1",
  "info": {
    "title": "OI.Service | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7128"
    },
    {
      "url": "http://localhost:5008"
    }
  ],
  "paths": {
    "/api/Ping": {
      "get": {
        "tags": [
          "Ping"
        ],
        "summary": "Will always return a 200\r\nThis endpoint it to be used to validate the service is up and running",
        "responses": {
          "200": {
            "description": "IActionResult."
          }
        }
      }
    },
    "/api/States": {
      "get": {
        "tags": [
          "States"
        ],
        "summary": "Returns all states.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IState"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IState"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IState"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IState": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Ping"
    },
    {
      "name": "States"
    }
  ]
}