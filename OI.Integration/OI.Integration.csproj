<Project Sdk="Microsoft.NET.Sdk">

  <!-- App-level wiring for talking to the other OI applications. Like OI.Common:
       reference this from application projects only, never from Business/Data/Glue. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OI.Common\OI.Common.csproj" />
    <ProjectReference Include="..\OI.Glue\OI.Glue.csproj" />
  </ItemGroup>

</Project>
