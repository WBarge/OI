<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The central hub. No reference to OI.Data or OI.Business on purpose: this application
       has no database, so it cannot cross a context boundary. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OI.Common\OI.Common.csproj" />
    <ProjectReference Include="..\OI.Glue\OI.Glue.csproj" />
    <ProjectReference Include="..\OI.Integration\OI.Integration.csproj" />
  </ItemGroup>

</Project>
